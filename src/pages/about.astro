---
import { getEntry, render } from "astro:content";
import Socials from "../components/Socials.astro";
import { site } from "../config";
import Base from "../layouts/Base.astro";

const about = await getEntry("spec", "about");
if (!about) throw new Error("src/content/spec/about.md is missing");
const { Content } = await render(about);
---

<Base title="About" description={`About ${site.author}, ${site.role}.`}>
	<div class="wrap narrow">
		<header class="page-head">
			<p class="eyebrow">{site.role}</p>
		</header>
		<div class="prose about">
			<Content />
		</div>
		<div style="margin-top: 2rem">
			<Socials labels />
		</div>
	</div>
</Base>

<style is:global>
	.prose.about h1 {
		margin-top: 0;
		padding: 0;
		border: 0;
		font-size: clamp(1.875rem, 5.5vw, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.025em;
	}
	.page-head:has(+ .about) {
		padding-bottom: 0.5rem;
	}
</style>
