---
import Archive from "../../../components/Archive.astro";
import Base from "../../../layouts/Base.astro";
import { getTaxonomy } from "../../../lib/posts";

export async function getStaticPaths() {
	const { categories } = await getTaxonomy();
	return [
		...categories.map((c) => ({
			params: { category: c.name },
			props: { category: c.name },
		})),
		// Kept for posts without a category (and because the URL always existed).
		{ params: { category: "uncategorized" }, props: { category: "" } },
	];
}

const { category } = Astro.props;
const label = category || "Uncategorized";
---

<Base title={label} description={`Posts in the ${label} category.`}>
	<div class="wrap narrow">
		<header class="page-head">
			<p class="eyebrow">Category</p>
			<h1>{label}</h1>
		</header>
		<Archive category={category} />
	</div>
</Base>
