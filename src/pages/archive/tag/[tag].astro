---
import Archive from "../../../components/Archive.astro";
import Base from "../../../layouts/Base.astro";
import { getTaxonomy } from "../../../lib/posts";

export async function getStaticPaths() {
	const { tags } = await getTaxonomy();
	return tags.map((t) => ({ params: { tag: t.name }, props: { tag: t.name } }));
}

const { tag } = Astro.props;
---

<Base title={`#${tag}`} description={`Posts tagged ${tag}.`}>
	<div class="wrap narrow">
		<header class="page-head">
			<p class="eyebrow">Tag</p>
			<h1>#{tag}</h1>
		</header>
		<Archive tag={tag} />
	</div>
</Base>
