---
import { Image } from "astro:assets";
import { type Post, postUrl } from "../lib/posts";
import PostMeta from "./PostMeta.astro";
import Tags from "./Tags.astro";

interface Props {
	post: Post;
	eager?: boolean;
}
const { post, eager = false } = Astro.props;
const { title, description, image, tags } = post.data;
---

<li class:list={["post-card", { "no-thumb": !image }]}>
	{
		image && (
			<div class="thumb">
				<Image
					src={image}
					alt=""
					width={640}
					height={400}
					fit="cover"
					widths={[320, 480, 640, 960]}
					sizes="(max-width: 40rem) 100vw, 15rem"
					loading={eager ? "eager" : "lazy"}
				/>
			</div>
		)
	}
	<div>
		<PostMeta post={post} />
		<h2><a href={postUrl(post)}>{title}</a></h2>
		{description && <p class="desc">{description}</p>}
		<Tags tags={tags} />
	</div>
</li>
