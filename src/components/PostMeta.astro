---
import {
	type Post,
	categoryUrl,
	formatDate,
	isoDate,
	readingTime,
} from "../lib/posts";

interface Props {
	post: Post;
}
const { post } = Astro.props;
const { published, updated, category } = post.data;
---

<div class="meta">
	<time datetime={isoDate(published)}>{formatDate(published)}</time>
	{category && <a href={categoryUrl(category)}>{category}</a>}
	<span>{readingTime(post)} min read</span>
	{
		updated && (
			<span>
				updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
			</span>
		)
	}
</div>
