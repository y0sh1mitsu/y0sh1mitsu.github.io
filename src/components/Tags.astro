---
import { tagUrl } from "../lib/posts";

interface Props {
	tags: string[];
}
const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags" aria-label="Tags">
			{tags.map((tag) => (
				<li>
					<a class="tag" href={tagUrl(tag)}>
						{tag}
					</a>
				</li>
			))}
		</ul>
	)
}
